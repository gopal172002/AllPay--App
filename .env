# AllPay Employee App — environment variables
# Restart Metro after changing: npm start -- --reset-cache

# Production API (Render)
API_BASE_URL=https://allpay-dashboard.onrender.com/api
# API_BASE_URL=http://localhost:5000/api

# Set to true to use local backend (Android emulator: 10.0.2.2:5000)
USE_LOCAL_API=false

# Optional — must match MOBILE_SYNC_SECRET in dashboard backend .env
MOBILE_SYNC_SECRET=
