# Copy to .env and adjust as needed:
#   copy .env.example .env

# Production API (Render)
API_BASE_URL=https://allpay-dashboard.onrender.com/api
# API_BASE_URL=http://localhost:5000/api

# Local development — set true and run dashboard backend on port 5000
USE_LOCAL_API=false

# Optional sync secret (match AllPay-Dashboard/backend/.env MOBILE_SYNC_SECRET)
MOBILE_SYNC_SECRET=
